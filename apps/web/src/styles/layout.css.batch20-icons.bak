:root {
  color-scheme: dark;
  --sp-bg: #0B111B;
  --sp-surface: #151F2E;
  --sp-elevated: #1C2A3B;
  --sp-gold: #D6AD55;
  --sp-gold-hover: #F0D28C;
  --sp-text: #F5F7FA;
  --sp-muted: #AAB7C9;
  --sp-border: #344052;
  --sp-success: #22C55E;
  --sp-error: #EF4444;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  min-height: 100vh;
  color: var(--sp-text);
  background:
    radial-gradient(ellipse at 85% 0%, rgba(214,173,85,.09), transparent 35%),
    radial-gradient(ellipse at 10% 30%, rgba(30,85,130,.25), transparent 50%),
    linear-gradient(135deg,#080F1B 0%,#14263A 50%,#0B111B 100%);
  font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
}

a { color: inherit; }
button { font: inherit; }

:focus-visible {
  outline: 2px solid var(--sp-gold-hover);
  outline-offset: 3px;
}

.app-layout {
  display: grid;
  grid-template-columns: 252px minmax(0, 1fr);
  min-height: 100vh;
}

.app-sidebar {
  position: sticky;
  top: 0;
  height: 100vh;
  overflow-y: auto;
  padding: 28px 18px;
  background: #101B2A;
  border-right: 1px solid var(--sp-border);
}

.app-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 38px;
  text-decoration: none;
  font-weight: 800;
  letter-spacing: .06em;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  border: 1px solid var(--sp-gold);
  border-radius: 11px;
  color: var(--sp-gold);
}

.nav-group { margin-bottom: 26px; }

.nav-group-title {
  margin: 0 12px 12px;
  color: var(--sp-muted);
  font-size: 11px;
  letter-spacing: .16em;
}

.nav-group nav { display: grid; gap: 4px; }

.nav-link {
  display: block;
  padding: 11px 13px;
  border-radius: 10px;
  color: var(--sp-muted);
  text-decoration: none;
  font-size: 14px;
  transition: background .2s, color .2s;
}

.nav-link:hover {
  color: var(--sp-text);
  background: var(--sp-elevated);
}

.nav-link.active {
  color: var(--sp-gold-hover);
  background: linear-gradient(
    90deg,
    rgba(214,173,85,.22),
    rgba(214,173,85,.03)
  );
}

.app-workspace { min-width: 0; }

.app-topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 76px;
  padding: 18px 32px;
  border-bottom: 1px solid var(--sp-border);
  background: rgba(11,17,27,.65);
}

.topbar-brand { font-weight: 750; letter-spacing: .07em; }

#api-status { color: var(--sp-muted); font-size: 13px; }

#app-content {
  width: min(100%, 1500px);
  margin: 0 auto;
  padding: 32px;
}

.mobile-navigation { display: none; }

@media (max-width: 900px) {
  .app-layout { display: block; }
  .app-sidebar { display: none; }
  .app-topbar { padding: 16px 20px; }
  #app-content { padding: 20px 16px 100px; }

  .mobile-navigation {
    position: fixed;
    z-index: 20;
    bottom: 0;
    left: 0;
    right: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    padding: 12px 6px;
    padding-bottom: max(12px, env(safe-area-inset-bottom));
    background: #101B2A;
    border-top: 1px solid var(--sp-border);
  }

  .mobile-navigation a {
    padding: 8px 2px;
    color: var(--sp-muted);
    text-align: center;
    text-decoration: none;
    font-size: 12px;
  }

  .mobile-navigation a.active { color: var(--sp-gold); }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    transition-duration: .01ms !important;
    animation-duration: .01ms !important;
  }
}