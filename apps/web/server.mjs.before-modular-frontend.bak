import { createServer } from 'node:http';
import { readFile } from 'node:fs/promises';
import { fileURLToPath } from 'node:url';
const root = fileURLToPath(new URL('.', import.meta.url));
const types = { '.html':'text/html; charset=utf-8', '.css':'text/css; charset=utf-8', '.js':'text/javascript; charset=utf-8' };
createServer(async(req,res)=>{ const pathname = new URL(req.url,'http://localhost').pathname; const name = pathname === '/' ? 'index.html' : pathname.slice(1); if(!['index.html','styles.css','app.js'].includes(name)){res.writeHead(404);res.end('Not found');return;} try { const data=await readFile(root+name); res.writeHead(200,{'Content-Type':types[name.slice(name.lastIndexOf('.'))]});res.end(data); } catch {res.writeHead(500);res.end('File unavailable');} }).listen(4173,()=>console.log('Sports web: http://localhost:4173'));
